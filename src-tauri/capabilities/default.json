{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidades de la ventana principal de ISALAB",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/reports/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$TEMP/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/reports/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$TEMP/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },
    "dialog:default"
  ]
}
